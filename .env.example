# PublisherOS — Environment variable template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development               # development | production | test
PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/publisheros
REDIS_URL=redis://localhost:6379

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In local dev, add custom domain origins here to test domain routing, e.g.:
#   CORS_ORIGINS=http://localhost:5173,http://alphapress.localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info                     # trace | debug | info | warn | error | fatal

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=pos_session
SESSION_IDLE_TTL_DAYS=30           # Sliding idle window (days)
SESSION_ABSOLUTE_TTL_DAYS=90       # Hard expiry (days)
COOKIE_DOMAIN=                     # Leave empty for localhost

# ── Application ───────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:5173  # Frontend base URL (used in emails)

# ── Domain routing ────────────────────────────────────────────────────────────
# ADMIN_DOMAIN: In production, only requests from this host can reach super-admin routes.
# In development (NODE_ENV=development), localhost is always treated as admin host.
ADMIN_DOMAIN=publisheros.com
ROOT_DOMAIN=publisheros.com

# ── Local custom-domain simulation (development only) ─────────────────────────
# To simulate publisher custom domains without buying real domains:
# 1. Add entries to /etc/hosts:
#      127.0.0.1  alphapress.localhost
#      127.0.0.1  betabooks.localhost
# 2. Add these origins to CORS_ORIGINS:
#      CORS_ORIGINS=http://localhost:5173,http://alphapress.localhost:5173,http://betabooks.localhost:5173
# 3. When the backend receives requests from alphapress.localhost it will
#    resolve to Publisher A (Alpha Press) via the customDomain field.
# 4. API calls from the browser still go to http://localhost:8000 — only the
#    Host header changes to simulate the routing.

# ── Email ─────────────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty in development — OTP will print in the backend terminal.
# Dev tip: use OTP "123456" to bypass email verification in development.
# In production, configure a real SMTP provider (Gmail, SendGrid, Resend, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                  # true for port 465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PublisherOS <noreply@publisheros.dev>

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
